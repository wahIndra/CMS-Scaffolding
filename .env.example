# ──────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/website_cms"

# ──────────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-before-production"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────────
# FILE UPLOAD
# ──────────────────────────────────────────────────
UPLOAD_PROVIDER="local"           # "local" | "s3"
UPLOAD_DIR="./public/uploads"
UPLOAD_MAX_SIZE_MB="10"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif,application/pdf"

# S3-compatible (leave empty when using local)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""                  # CDN or bucket public base URL

# ──────────────────────────────────────────────────
# SITE (used as defaults before settings are seeded)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="My Company"
